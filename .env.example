# Copy to .env. All values are secrets except the URL and bucket name.
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase dashboard -> Project Settings -> API Keys -> Secret key (sb_secret_...). Server-only.
SUPABASE_SECRET_KEY=

# Same R2 bucket and token as front-zurag.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=zurag-photos
